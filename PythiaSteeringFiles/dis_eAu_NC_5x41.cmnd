! DIS Steering File equivalent to main341.cc

! 1. Beam Settings
Beams:frameType = 2
Beams:idA = 1000791970      ! Au-197
Beams:idB = 11        ! Electron
Beams:eA = 41.0      ! High energy proton
Beams:eB = 5.0       ! Electron energy

! 2. Process Selection
WeakBosonExchange:ff2ff(t:gmZ) = on
PhaseSpace:Q2Min = 1

! 3. DIS Specific Shower Settings
SpaceShower:dipoleRecoil = on
SpaceShower:pTmaxMatch = 2
PDF:lepton = off
TimeShower:QEDshowerByL = off

! 4. PDF Selection (Your LHAPDF choice)
PDF:pSet = LHAPDF6:nNNPDF10_nlo_as_0118_Au197/0

! 5. Event Count
Main:numberOfEvents = 100